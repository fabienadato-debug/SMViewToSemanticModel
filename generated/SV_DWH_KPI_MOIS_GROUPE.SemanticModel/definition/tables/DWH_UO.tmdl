/// Referential of Branches
table DWH_UO

	/// Area of Branches (each Group is part of one Area)
	column AREA_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: AREA_CODE

	/// Code for Agency
	column BRANCH_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: BRANCH_CODE

	/// List of agency names.
	column BRANCH_NAME
		dataType: string
		summarizeBy: none
		sourceColumn: BRANCH_NAME

	/// Country Code
	column COUNTRY_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: COUNTRY_CODE

	/// Group of Branches (each Branch is part of one Group)
	column GROUP_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: GROUP_CODE

	column __rel_DWH_KPI_MOIS_GROUPE_DWH_UO
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: __rel_DWH_KPI_MOIS_GROUPE_DWH_UO

	partition DWH_UO = m
		mode: import
		source =
			let
			    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = SnowflakeRole]),
			    Database = Source{[Name = "DWHP"]}[Data],
			    Schema = Database{[Name = "GROUPE"]}[Data],
			    SourceTable = Schema{[Name = "DWH_UO"]}[Data],
			    SelectedColumns = Table.SelectColumns(SourceTable, {"UOCODLEV6", "UOCODLEV8", "LIBELLE_UO", "CODE_PAYS", "UOCODLEV7"}),
			    RenamedColumns = Table.RenameColumns(SelectedColumns, {{"UOCODLEV6", "AREA_CODE"}, {"UOCODLEV8", "BRANCH_CODE"}, {"LIBELLE_UO", "BRANCH_NAME"}, {"CODE_PAYS", "COUNTRY_CODE"}, {"UOCODLEV7", "GROUP_CODE"}}),
			    AddedRelationshipKey1 = Table.AddColumn(RenamedColumns, "__rel_DWH_KPI_MOIS_GROUPE_DWH_UO", each Text.Combine(List.Transform({[COUNTRY_CODE], [BRANCH_CODE]}, each if _ = null then "-1:" else Text.From(Text.Length(Text.From(_))) & ":" & Text.From(_)), "|"), type text)
			in
			    AddedRelationshipKey1
