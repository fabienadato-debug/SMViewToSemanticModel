/// Referential of Products (Racines)
table V_PRODUCT

	/// Country code of the product.
	column COUNTRY_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: COUNTRY_CODE

	/// Unique Inventory Value in Euros.
	column IV
		dataType: decimal
		summarizeBy: none
		sourceColumn: IV

	/// Unique Inventory Value in local currency
	column IV_LOCAL_CURRENCY
		dataType: decimal
		summarizeBy: none
		sourceColumn: IV_LOCAL_CURRENCY

	/// Language code of the product.
	column LANGUAGE_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: LANGUAGE_CODE

	/// Unique identifier for a product.
	column PRODUCT_CODE
		dataType: string
		summarizeBy: none
		sourceColumn: PRODUCT_CODE

	/// Stock type: MATID (identified), MATQT (quantity), CONSO (consumable)
	column STOCK_TYPE
		dataType: string
		summarizeBy: none
		sourceColumn: STOCK_TYPE

	column TYPE
		dataType: string
		summarizeBy: none
		sourceColumn: TYPE

	column __rel_DWH_KPI_MOIS_GROUPE_V_PRODUCT
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: __rel_DWH_KPI_MOIS_GROUPE_V_PRODUCT

	partition V_PRODUCT = m
		mode: import
		source =
			let
			    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = SnowflakeRole]),
			    Database = Source{[Name = "DWHP"]}[Data],
			    Schema = Database{[Name = "GROUPE"]}[Data],
			    SourceTable = Schema{[Name = "V_PRODUCT"]}[Data],
			    SelectedColumns = Table.SelectColumns(SourceTable, {"CODE_PAYS", "VI", "VI_DEVISE", "CODE_LANGUE", "CODE_PRODUIT", "TENU_EN_STOCK", "TYPE"}),
			    RenamedColumns = Table.RenameColumns(SelectedColumns, {{"CODE_PAYS", "COUNTRY_CODE"}, {"VI", "IV"}, {"VI_DEVISE", "IV_LOCAL_CURRENCY"}, {"CODE_LANGUE", "LANGUAGE_CODE"}, {"CODE_PRODUIT", "PRODUCT_CODE"}, {"TENU_EN_STOCK", "STOCK_TYPE"}}),
			    AddedRelationshipKey1 = Table.AddColumn(RenamedColumns, "__rel_DWH_KPI_MOIS_GROUPE_V_PRODUCT", each Text.Combine(List.Transform({[COUNTRY_CODE], [PRODUCT_CODE]}, each if _ = null then "-1:" else Text.From(Text.Length(Text.From(_))) & ":" & Text.From(_)), "|"), type text)
			in
			    AddedRelationshipKey1
