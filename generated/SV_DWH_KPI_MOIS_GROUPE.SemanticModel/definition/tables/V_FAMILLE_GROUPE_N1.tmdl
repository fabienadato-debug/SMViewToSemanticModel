	/// Product family label level 1 (gamme) in Portuguese
	column FAMILY_LABEL_PT_1
		dataType: string
		summarizeBy: none
		sourceColumn: FAMILY_LABEL_PT_1

	partition V_FAMILLE_GROUPE_N1 = m
		mode: import
		source =
			let
			    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = SnowflakeRole]),
			    Database = Source{[Name = "DWHP"]}[Data],
			    Schema = Database{[Name = "GROUPE"]}[Data],
			    SourceTable = Schema{[Name = "V_FAMILLE_GROUPE_N1"]}[Data],
			    SelectedColumns = Table.SelectColumns(SourceTable, {"CODE_FAMILLE_GROUPE_1", "LIB_FAMILLE_GROUPE_DA_1", "LIB_FAMILLE_GROUPE_DE_1", "LIB_FAMILLE_GROUPE_EN_1", "LIB_FAMILLE_GROUPE_ES_1", "LIB_FAMILLE_GROUPE_FR_1", "LIB_FAMILLE_GROUPE_IT_1", "LIB_FAMILLE_GROUPE_PL_1", "LIB_FAMILLE_GROUPE_PT_1"}),
			    RenamedColumns = Table.RenameColumns(SelectedColumns, {{"LIB_FAMILLE_GROUPE_DA_1", "FAMILY_LABEL_DA_1"}, {"LIB_FAMILLE_GROUPE_DE_1", "FAMILY_LABEL_DE_1"}, {"LIB_FAMILLE_GROUPE_EN_1", "FAMILY_LABEL_EN_1"}, {"LIB_FAMILLE_GROUPE_ES_1", "FAMILY_LABEL_ES_1"}, {"LIB_FAMILLE_GROUPE_FR_1", "FAMILY_LABEL_FR_1"}, {"LIB_FAMILLE_GROUPE_IT_1", "FAMILY_LABEL_IT_1"}, {"LIB_FAMILLE_GROUPE_PL_1", "FAMILY_LABEL_PL_1"}, {"LIB_FAMILLE_GROUPE_PT_1", "FAMILY_LABEL_PT_1"}})
