	/// Product family label level 1 (gamme) in Spanish
	column FAMILY_LABEL_ES_1
		dataType: string
		summarizeBy: none
		sourceColumn: FAMILY_LABEL_ES_1

	/// Product family label level 1 (gamme) in French
	column FAMILY_LABEL_FR_1
		dataType: string
		summarizeBy: none
