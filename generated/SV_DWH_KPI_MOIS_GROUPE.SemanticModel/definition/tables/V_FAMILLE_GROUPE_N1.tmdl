/// Reference table for product family hierarchy level 1 (gamme) with multilingual labels. One row per unique CODE_FAMILLE_GROUPE_1. Languages: DA=Danish, DE=German, EN=English, ES=Spanish, FR=French, IT=Italian, PL=Polish, PT=Portuguese.
table V_FAMILLE_GROUPE_N1

	/// Product family group code level 1 (gamme). A=Earthmoving, B=Access/Lifting, C=Vehicles, D=Tools, E=Modules, F=Energy, G=Other Specialties.
	column CODE_FAMILLE_GROUPE_1
		dataType: string
		summarizeBy: none
		sourceColumn: CODE_FAMILLE_GROUPE_1

	/// Product family label level 1 (gamme) in Danish
	column FAMILY_LABEL_DA_1
		dataType: string
		summarizeBy: none
		sourceColumn: FAMILY_LABEL_DA_1

	/// Product family label level 1 (gamme) in German
	column FAMILY_LABEL_DE_1
		dataType: string
		summarizeBy: none
		sourceColumn: FAMILY_LABEL_DE_1

