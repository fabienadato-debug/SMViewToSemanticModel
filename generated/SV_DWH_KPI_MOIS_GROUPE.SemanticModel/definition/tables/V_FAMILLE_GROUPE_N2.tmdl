			    SelectedColumns = Table.SelectColumns(SourceTable, {"CODE_FAMILLE_GROUPE_1", "CODE_FAMILLE_GROUPE_2", "LIB_FAMILLE_GROUPE_DA_2", "LIB_FAMILLE_GROUPE_DE_2", "LIB_FAMILLE_GROUPE_EN_2", "LIB_FAMILLE_GROUPE_ES_2", "LIB_FAMILLE_GROUPE_FR_2", "LIB_FAMILLE_GROUPE_IT_2", "LIB_FAMILLE_GROUPE_PL_2", "LIB_FAMILLE_GROUPE_PT_2"}),
