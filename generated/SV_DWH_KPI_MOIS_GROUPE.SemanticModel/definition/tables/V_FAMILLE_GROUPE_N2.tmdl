			    AddedRelationshipKey1 = Table.AddColumn(RenamedColumns, "__rel_DWH_KPI_MOIS_GROUPE_FAMILLE_N2", each Text.Combine(List.Transform({[CODE_FAMILLE_GROUPE_1], [CODE_FAMILLE_GROUPE_2]}, each if _ = null then "-1:" else Text.From(Text.Length(Text.From(_))) & ":" & Text.From(_)), "|"), type text)
